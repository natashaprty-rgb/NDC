# NDC Somalia Management System - environment template.
# Copy to .env and fill in real values on each server. Never commit .env.

APP_NAME="NDC Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mis.example.gov.so
APP_TIMEZONE=Africa/Mogadishu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=90

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ndc_mis
DB_USERNAME=ndc_mis
DB_PASSWORD=

# Scratch database used only by `php artisan ndc:backup:test-restore`.
# Must be a separate, disposable database - never the live one.
RESTORE_TEST_DB_DATABASE=
RESTORE_TEST_DB_HOST=
RESTORE_TEST_DB_USERNAME=
RESTORE_TEST_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Backups: archives are written to the "backups" disk. Point BACKUP_PATH at
# a mounted volume that is copied off the server, or change the disk to s3/sftp.
BACKUP_DISK=backups
BACKUP_PATH=
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.gov.so"
MAIL_FROM_NAME="${APP_NAME}"
